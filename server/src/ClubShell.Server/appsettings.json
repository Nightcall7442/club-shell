{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStart": true
  },
  "Contracts": {
    "OpenApiPath": "contracts/openapi.yaml"
  },
  "Auth": {
    "Issuer": "clubshell-server",
    "Audience": "club-agent",
    "SigningKeyPath": "data/jwt-signing-key.pem",
    "AgentTokenMinutes": 60,
    "RefreshTokenDays": 30,
    "SignatureWindowSec": 300
  },
  "Club": {
    "Name": "ClubShell",
    "TimeZone": "Asia/Tashkent",
    "EnrollmentKey": "",
    "PreviousEnrollmentKey": "",
    "AutoApprovePcs": false
  },
  "Realtime": {
    "PingSec": 20,
    "PongTimeoutSec": 10,
    "MaxFrameBytes": 1048576
  },
  "Agents": {
    "HeartbeatSec": 30,
    "OfflineAfterSec": 90,
    "CommandTtlMin": 10
  },
  "Sessions": {
    "GraceSec": 60,
    "MaxOfflineMinutes": 240
  },
  "Catalog": {
    "PolicySeedPath": "data/policy.json"
  },
  "Workers": {
    "Enabled": true
  },
  "Proxy": {
    "Trusted": [],
    "ClientIpHeader": ""
  }
}
