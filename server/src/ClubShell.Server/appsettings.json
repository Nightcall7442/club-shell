{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStart": true
  },
  "Contracts": {
    "OpenApiPath": "contracts/openapi.yaml"
  },
  "Auth": {
    "Issuer": "clubshell-server",
    "Audience": "club-agent",
    "SigningKeyPath": "data/jwt-signing-key.pem",
    "AgentTokenMinutes": 60,
    "SignatureWindowSec": 300
  },
  "Club": {
    "Name": "ClubShell",
    "TimeZone": "Asia/Tashkent",
    "EnrollmentKey": "",
    "PreviousEnrollmentKey": ""
  },
  "Proxy": {
    "Trusted": [],
    "ClientIpHeader": ""
  }
}
