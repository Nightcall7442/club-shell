<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ClubShell.Server</RootNamespace>
    <AssemblyName>ClubShell.Server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="FluentMigrator.Runner.Postgres" />
    <!-- JSON Schema of the contract for the settings documents of the console (PATCH /admin/club, DESIGN §4.2). -->
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Npgsql" />
    <!-- Error reporting (D-72): off without Sentry:Dsn. -->
    <PackageReference Include="Sentry.AspNetCore" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/ClubShell.Contracts/ClubShell.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../contracts/openapi.yaml" Link="contracts/openapi.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../contracts/openapi.json" Link="contracts/openapi.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Default policy seed (DESIGN §11 S1, D-14) when data/policy.json is absent. -->
    <Content Include="../../../config/policies.example.json" Link="seed/policies.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Starter catalogs: enabled with Catalog:GamesSeedPath=seed/games.example.json and Catalog:ProductsSeedPath=seed/products.example.json. -->
    <Content Include="../../../config/games.example.json" Link="seed/games.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../config/products.example.json" Link="seed/products.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
