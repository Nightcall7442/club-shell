# Copy to server/.env (not committed) and fill in. Read by `docker compose -f server/compose.yaml`.

# PostgreSQL password (used by both containers). Alphanumeric: it is embedded in a connection string.
POSTGRES_PASSWORD=

# Enrollment key the agents send when they register (X-Club-Key). Rotate: set the new value here and the old one in
# Club__PreviousEnrollmentKey, roll the key out to the agents, then drop the old one.
CLUB_ENROLLMENT_KEY=

# Origin of the admin console (scheme://host[:port], no trailing slash), for CORS on /api/v1/admin/*.
CORS_ORIGIN=

# Owner PIN created on the very first start when the staff table is empty. Empty: a random PIN is written to the log once.
CLUB_OWNER_PIN=

# Platform administration (several clubs on this server, page /platform of the console): 24+ random characters.
# Empty turns it off.
PLATFORM_ADMIN_KEY=

# Optional
CLUB_NAME=ClubShell
CLUB_TIMEZONE=Asia/Tashkent
# true approves every new PC without the owner: dev and tests only.
CLUB_AUTO_APPROVE_PCS=false
# X-Real-IP behind Railway or a proxy that overwrites the header; empty when exposed directly.
PROXY_CLIENT_IP_HEADER=
SERVER_PORT=8080
# Catalog of games and products: the files in the data volume (default), or the samples shipped in the image:
#   CATALOG_GAMES_SEED=seed/games.example.json
#   CATALOG_PRODUCTS_SEED=seed/products.example.json
CATALOG_GAMES_SEED=data/games.json
CATALOG_PRODUCTS_SEED=data/products.json
