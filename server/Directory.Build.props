<Project>

  <!--
    Central server (DESIGN.md §2.1). The repository props admit only projects under tests/ as test projects, so
    server/tests/** opts in here, before the import: the repository test-project settings key off IsTestProject.
  -->
  <PropertyGroup>
    <IsTestProject Condition="'$(IsTestProject)' == '' and $([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)').StartsWith($([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'tests'))))">true</IsTestProject>
  </PropertyGroup>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

</Project>
