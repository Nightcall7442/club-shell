# ClubShell — local development environment.
# Copy to `.env` (git-ignored) and fill in what you need. Consumed by tools/scripts/*.ps1,
# tools/MockServer and the Shell dev build. The Agent itself reads C:\ProgramData\ClubShell\agent.json
# plus CLUBSHELL__<Section>__<Key> overrides (see docs/ARCHITECTURE.md §9); the scripts map the values below.

# Central server REST base URL (agent.json -> server.baseUrl). Dev default points at tools/MockServer.
CLUBSHELL_SERVER_URL=http://localhost:8080/api/v1

# Club API key used for the first agent registration (POST /agents/register). Secret in real deployments.
CLUBSHELL_CLUB_API_KEY=dev-club-api-key

# WebSocket URL of the agent realtime channel (agent.json -> server.wsUrl).
CLUBSHELL_WS_URL=ws://localhost:8080/ws/agent

# Update channel to check manifests against: stable | beta.
CLUBSHELL_UPDATE_CHANNEL=stable

# Agent log level: Verbose | Debug | Information | Warning | Error | Fatal.
CLUBSHELL_LOG_LEVEL=Debug

# TCP port the mock central server (tools/MockServer) listens on.
MOCK_SERVER_PORT=8080

# 1 = Shell frontend runs in the browser against mocked Tauri commands / the mock server (vite dev). 0 = real Tauri.
VITE_MOCK=1

# Central/mock server base URL used by the Shell for dev-only links (QR pages, images); see apps/shell/src/vite-env.d.ts.
VITE_SERVER_URL=http://localhost:8080

# Tauri updater signing private key (key contents or a path to the .key file). Generate: pnpm tauri signer generate.
TAURI_SIGNING_PRIVATE_KEY=

# Password protecting TAURI_SIGNING_PRIVATE_KEY (leave empty if the key has none).
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Authenticode code-signing certificate (.pfx) used by tools/scripts/sign.ps1 for the MSIs and executables.
CODESIGN_PFX_PATH=

# Password of the .pfx above.
CODESIGN_PFX_PASSWORD=

# --- CI-only (.github/workflows/release.yml): GitHub Actions secrets/variables, never needed in a local .env. ---
# Secrets consumed by the `build` job (all optional; unsigned builds are produced with a warning):
#   TAURI_SIGNING_PRIVATE_KEY / TAURI_SIGNING_PRIVATE_KEY_PASSWORD  same meaning as above (Tauri updater signatures)
#   CODESIGN_PFX_BASE64            base64 of the .pfx; decoded into CODESIGN_PFX_PATH for sign.ps1 / package.ps1
#   CODESIGN_PFX_PASSWORD          same meaning as above
#   UPDATE_MANIFEST_KEY_PEM        RSA private key PEM -> sign.ps1 -ManifestPath <release>\manifest.json -ManifestKeyPem
#   UPDATE_BASE_URL                package.ps1 -BaseUrl (default: the GitHub release download URL); also the
#                                  publish.ps1 -Target Http -Destination for HTTP publishing
# Secrets/variables consumed by the `publish` job (environment "production"; one of the two backends is required):
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY  S3 publishing (publish.ps1 -Target S3 -Destination s3://$UPDATE_S3_BUCKET)
#   AWS_REGION (variable)          publish.ps1 -AwsRegion; default eu-central-1
#   UPDATE_S3_BUCKET (variable)    bucket[/prefix] the release layout is uploaded to
#   CLUBSHELL_PUBLISH_TOKEN        bearer token for publish.ps1 -Target Http (read from the environment, or -Token)
