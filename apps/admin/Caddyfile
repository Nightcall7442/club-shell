# Static admin console. Sections live in the URL hash (#/tariffs), so no SPA rewrites are needed.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	# The platform administration page (apps/admin/platform.html) at a short address.
	rewrite /platform /platform.html
	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
	# Hashed bundle files never change; index.html must be revalidated so a new deploy is picked up at once.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@index path / /index.html
	header @index Cache-Control "no-cache"
	# PWA: the service worker and the manifest are checked on every start so an update reaches the installed app.
	@pwa path /sw.js /manifest.webmanifest
	header @pwa Cache-Control "no-cache"
	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"
}
