{
  "name": "@clubshell/admin",
  "version": "1.0.0",
  "private": true,
  "description": "Club counter (cashier) console: hall map, open time on a seat, top up a wallet, extend or end a session, push commands to a PC. Talks to the mock server's /api/v1/admin routes; listens on http://localhost:1421",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clubshell/contracts": "workspace:*",
    "@fontsource-variable/doto": "5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "clsx": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.5.0",
    "@types/react": "18.3.4",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.41",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4",
    "vite": "5.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
