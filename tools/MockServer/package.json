{
  "name": "@clubshell/mock-server",
  "version": "1.0.0",
  "private": true,
  "description": "Fastify + ws mock of the ClubShell central server (REST /api/v1 + WebSocket /ws/agent) for development and e2e tests; listens on http://localhost:8080",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clubshell/contracts": "workspace:*",
    "@fastify/cors": "9.0.1",
    "@fastify/websocket": "10.0.1",
    "fastify": "4.28.1",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "22.5.0",
    "@types/ws": "8.5.12",
    "tsx": "4.19.0",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
