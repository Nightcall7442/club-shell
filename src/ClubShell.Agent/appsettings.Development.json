{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ClubShell": {
    "Dev": true,
    "logging": {
      "level": "Debug"
    },
    "server": {
      "baseUrl": "http://localhost:8080/api/v1",
      "wsUrl": "ws://localhost:8080/ws/agent"
    },
    "offline": {
      "enabled": true,
      "allowNewSessions": true,
      "maxOfflineMinutes": 1440
    }
  }
}
